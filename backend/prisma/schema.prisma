// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  firstName           String?
  lastName            String?
  password            String?
  role                String?
  plan                plans    @default(FREE)
  stripeCustomerId    String?  @unique
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt 


  reports     Report[]
  auditLogs   AuditLog[]
  connections WorkspaceConnection[]
}

model Report {
  id                  String   @id @default(uuid()) 
  userId              String   
  platform            String?
  summary             String
  hiddenWins          String[]
  growthOpportunities Json     
  networkingTargets   String[] 
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceConnection {
  id           String    @id @default(uuid())
  userId       String
  platform     String    // e.g., "GITHUB"
  accessToken  String
  refreshToken String?
  expiresAt    DateTime? 
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  
  action       String   
  resourceType String?  
  resourceId   String?  
  metadata     Json?    
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId]) 
  @@index([action]) 
}

enum plans {
    FREE
    PRO
    ELITE
}